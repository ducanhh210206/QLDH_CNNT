# Cấu hình API trong backend/.env; đây là cấu hình Docker Compose.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=order_management
DB_USER=order_user
DB_PASSWORD=
JWT_SECRET=
MONITOR_TOKEN=
CORS_ORIGINS=http://localhost:8080

# Google OAuth (optional). Use the FE/gateway callback origin, same as FRONTEND_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/auth/google/callback
FRONTEND_URL=http://127.0.0.1:5173
