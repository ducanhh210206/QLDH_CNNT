MONITOR_HOST=127.0.0.1
MONITOR_PORT=5001
MONITOR_TOKEN=
PRIMARY_URL=http://127.0.0.1:5000
STANDBY_URL=
GATEWAY_URL=
MONITOR_INTERVAL_MS=10000
# Optional durable directory. Docker: mount a volume here.
# MONITOR_DATA_DIR=/absolute/path/to/monitoring-data
# Read-only replica monitoring (never use the application database password in the frontend).
REPLICA_DB_HOST=
REPLICA_DB_PORT=3308
REPLICA_DB_USER=
REPLICA_DB_PASSWORD=
REPLICA_DB_SSL=false
REPLICA_DB_SSL_CA_FILE=
