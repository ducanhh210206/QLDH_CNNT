# Copy to backend/.env.hosting for one-time provisioning from your computer.
# This file contains placeholders, never paste real credentials into this example.
DB_HOST=HOST_FROM_AIVEN
DB_PORT=PORT_FROM_AIVEN
DB_NAME=order_management
DB_USER=USER_FROM_AIVEN
DB_PASSWORD=REPLACE_WITH_AIVEN_PASSWORD
DB_SSL=true
DB_SSL_CA_FILE=/absolute/path/to/ca.pem
